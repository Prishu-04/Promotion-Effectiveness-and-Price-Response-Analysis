# Copy this file to `.env` and edit the copy:   cp .env.example .env
# `.env` is git-ignored. NEVER put real keys in this example file.
# Real environment variables override values from `.env`.
# Blank value = "use the default".

APP_ENV=local            # local | test | production
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- LLM used for answer generation (needed from Stage 8) ---
# Provider: unset | openai | anthropic | ollama
LLM_PROVIDER=unset
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# --- Embedding model used for semantic search (needed from Stage 5) ---
# Provider: unset | openai | sentence_transformers | ollama
EMBEDDING_PROVIDER=unset
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Paths (relative paths are resolved from the project root) ---
DATA_DIR=data
SAMPLE_DATA_DIR=data/sample
VECTOR_STORE_DIR=var/chroma
