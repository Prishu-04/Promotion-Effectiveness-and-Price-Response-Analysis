# Copy this file to .env and edit the copy. .env is ignored by git.
# Do not put real keys in this example file.
# A blank value means "use the default".

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# LLM provider: unset, openai, anthropic or ollama (used from stage 8)
LLM_PROVIDER=unset
LLM_MODEL=
LLM_API_KEY=

# embedding provider: unset, openai, sentence_transformers or ollama (used from stage 5)
EMBEDDING_PROVIDER=unset
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# folders, relative to the project folder
DATA_DIR=data
SAMPLE_DATA_DIR=data/sample
VECTOR_STORE_DIR=var/chroma
